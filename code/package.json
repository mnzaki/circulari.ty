{
  "name": "o19",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "tauri:dev": "turbo run tauri:dev --filter='!DearDiary' -F '!stayreal'",
    "tauri:dev:MeStreamm": "turbo run tauri:dev --filter='!DearDiary' -F '!stayreal'",
    "tauri:dev:DearDiary": "turbo run tauri:dev --filter='!MeStreamm' -F '!stayreal'",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "turbo": "^2.8.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
