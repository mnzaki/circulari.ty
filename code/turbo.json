{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", ".vercel/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "tauri:dev": {
      "cache": false,
      "persistent": true
    },
    "tauri:android:dev": {
      "cache": false,
      "persistent": true
    },
    "tauri:android:dev:verbose": {
      "cache": false,
      "persistent": true
    },
    "tauri:android:dev:tokio_debug": {
      "cache": false,
      "persistent": true
    },
    "tauri:build": {
      "outputs": ["src-tauri/target/**"]
    }
  }
}
