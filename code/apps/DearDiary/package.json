    "tauri:android:dev:tokio_debug": "RUST_LOG=debug RUSTFLAGS=\"--cfg tokio_unstable\" tauri android dev --features tokio_debugging",
    "tauri:android:dev:log": "cd ../../../o19/packages/debug && pnpm tauri:android:dev",
